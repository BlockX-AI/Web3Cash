# ─────────────────────────────────────────────────────────────────────────────
# Web3Cash — environment variables (Phase 1)
# Copy to .env (root) for local dev. In production, set these in Railway/Vercel.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
ADMIN_SECRET=change-me-admin-secret-2024
FRONTEND_URL=http://localhost:5173

# ── Database (Postgres) ────────────────────────────────────────────────────
# Local docker-compose default. In Railway, this is auto-injected as DATABASE_URL.
DATABASE_URL=postgresql://web3cash:web3cash@localhost:5433/web3cash?schema=public

# ── Redis (Upstash in prod, local docker in dev) ───────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ───────────────────────────────────────────────────────────────────
# 32+ char random secret. Generate: openssl rand -base64 48
JWT_SECRET=cFqHQw99oT7YsGiXdJiEPR8PmunOLSnDKQiU5d/RR9B4aav8RP5/DyLtBKGjers+
# Used in SIWE messages
SIWE_DOMAIN=localhost:5173
SIWE_URI=http://localhost:5173
SIWE_STATEMENT=Sign in to Web3Cash. This will not trigger a transaction or cost any gas.

# ── Blockchain (Phase 1: read-only, for Sybil scoring) ─────────────────────
# Get from https://dashboard.alchemy.com — Ethereum Mainnet app
ALCHEMY_API_KEY=YLzwTt4civKkUzVKrAe0h
ALCHEMY_NETWORK=eth-sepolia
# Default chain for the MVP
DEFAULT_CHAIN_ID=11155111

# ── Frontend (Next.js) ─────────────────────────────────────────────────────
# Get from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=8b7d0a01dd31460360b4200661ade5f1
NEXT_PUBLIC_APP_URL=http://localhost:5173
NEXT_PUBLIC_DEFAULT_CHAIN_ID=11155111
NEXT_PUBLIC_ALCHEMY_API_KEY=YLzwTt4civKkUzVKrAe0h
NEXT_PUBLIC_USDC_TOKEN_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS_V2=0x6726a4A8B149F59Db599FEBF450F279e82951560

# ── Twitter OAuth 2.0 (Phase 2) ────────────────────────────────────────────
# Get from https://developer.twitter.com → Project → OAuth 2.0 settings.
# Callback URL must match TWITTER_REDIRECT_URI exactly.
TWITTER_CLIENT_ID=NGJT7G5Z7VNR0R7TUKZ10DgyUGY6MTpJaQ
TWITTER_CLIENT_SECRET=6uUfS_p5GbBeBAGGQ0T5R1910d16Va5JpC2WVDeySndE_JmVV9
TWITTER_REDIRECT_URI=http://localhost:3001/api/oauth/twitter/callback
# Bearer for server-to-server lookups (optional; falls back to user tokens).
TWITTER_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAAiR9QEAAAAAbPcqZ%2FvdwRWqpYep%2Bv6YbyriSVg%3DoV4GaEDagXh0wCrjZG1H2PVRT9s7jr8Ii5ufcQMVgbXwNZjmyW

# ── Discord OAuth (Phase 5) ────────────────────────────────────────────────
# Get from https://discord.com/developers/applications → OAuth2.
# Scopes: identify, guilds. Redirect must match DISCORD_REDIRECT_URI exactly.
DISCORD_CLIENT_ID=1500206450432020737
DISCORD_CLIENT_SECRET=u828kNsNTSYvjVVD6XhYEO4LCu4InmdF
DISCORD_REDIRECT_URI=http://localhost:3001/api/oauth/discord/callback

# ── GitHub OAuth (Phase 5) ─────────────────────────────────────────────────
# Get from https://github.com/settings/developers → New OAuth App.
# Scopes: read:user, user:email, public_repo.
GITHUB_CLIENT_ID=Ov23liguqS4xJ2Bo9lzH
GITHUB_CLIENT_SECRET=b4a059c41d0d0b81e69375e1b3deb6ad76e14428
GITHUB_REDIRECT_URI=http://localhost:3001/api/oauth/github/callback

# ── Persona KYC (Phase 5) ──────────────────────────────────────────────────
# Get from https://app.withpersona.com → Account → API keys.
# Webhook secret is set in Persona dashboard → Webhooks.
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=

# ── OAuth token encryption (Phase 2) ───────────────────────────────────────
# 16+ char secret used to derive an AES-256 key for tokens-at-rest.
# Generate: openssl rand -base64 32
OAUTH_ENC_KEY=9QHX6vdYaGOF1hojEw2rNveDx9fo3ZTvsDM4DWOD8f8=

# ── Gnosis Safe payouts (Phase 3) ──────────────────────────────────────────
# A funded Safe holding USDC that pays out to users. Owners co-sign each batch.
# Set up at https://app.safe.global, then fund with USDC on the chosen chain.
GNOSIS_SAFE_ADDRESS=
GNOSIS_SAFE_CHAIN_ID=11155111
# Public Safe Transaction Service URL for the chain. Defaults shown below.
#   Mainnet:        https://safe-transaction-mainnet.safe.global
#   Sepolia:        https://safe-transaction-sepolia.safe.global
#   Base:           https://safe-transaction-base.safe.global
#   Polygon:        https://safe-transaction-polygon.safe.global
GNOSIS_SAFE_TX_SERVICE=https://safe-transaction-sepolia.safe.global
# An owner address that proposes the batch (read-only on the proposal step).
GNOSIS_SAFE_PROPOSER=
GNOSIS_SAFE_PROPOSER_PK=
# Active payout provider for queued withdrawals.
# GNOSIS_SAFE (Phase 3) | ESCROW_CONTRACT (Phase 6) | CIRCLE_API (reserved)
PAYOUT_PROVIDER=ESCROW_CONTRACT_V2

# ── Phase 6: Web3Cash on-chain escrow ──────────────────────────────────────
# Filled in after running `pnpm --filter @web3cash/contracts deploy:sepolia`.
# Switch PAYOUT_PROVIDER=ESCROW_CONTRACT once these are set.
ESCROW_CONTRACT_ADDRESS=0xA67F9b4a122Ef009Ef45eA4fd3C3c250C94F9dd7
ESCROW_CONTRACT_ADDRESS_V2=0x6726a4A8B149F59Db599FEBF450F279e82951560
REGISTRY_CONTRACT_ADDRESS=
# bytes32 — keccak256 of the active campaign UUID (use `campaignIdFromUuid`).
ESCROW_CAMPAIGN_ID=0x6b86b273ff34fce19d6b804eff5a3f5747ada4eaa22f1d49c01e52ddb7875b4b
# Hot key the backend uses to sign EIP-712 Claims. Rotate via setAttestor()
# if it leaks. MUST differ from CORE_WALLET_PRIVATE_KEY in production.
ESCROW_ATTESTOR_PRIVATE_KEY=0x0ce04145050d9746a52aa61763387e78c87de32f75507b2c37255d8f31bdc269
# Hot wallet that broadcasts claim() txs. Needs ETH for gas. Re-uses
# CORE_WALLET_PRIVATE_KEY if unset (fine for local dev only).
CORE_WALLET_PRIVATE_KEY=0x0ce04145050d9746a52aa61763387e78c87de32f75507b2c37255d8f31bdc269
# Etherscan key for `pnpm verify:sepolia`.
ETHERSCAN_API_KEY=

# ── Offer18 Affiliate Tracking ────────────────────────────────────────────
# Your Offer18 account tracking domain (no trailing slash)
OFFER18_TRACKING_DOMAIN=https://compliledger125060.offer18.com
# Offer18 uses IP whitelisting for postback security — whitelist your Railway IP in Offer18 → Postback
# Goal IDs — configure goals in Offer18 dashboard, then paste the numeric IDs here
OFFER18_GOAL_SIGNUP=1
OFFER18_GOAL_QUEST_COMPLETE=2
OFFER18_GOAL_KYC_VERIFIED=3
OFFER18_GOAL_DEPOSIT=4

# ── Phase 3+ (placeholders) ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
VIRTUAL_API_KEY= "acp-4b99768bdd2577f5e9bf"
# ── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
