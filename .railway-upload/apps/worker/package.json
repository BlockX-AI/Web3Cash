    "@web3cash/shared": "*",
    "@web3cash/sybil": "*",
    "@web3cash/verifiers": "*",
    "bullmq": "^5.20.0",
    "ioredis": "^5.4.1",
    "pino": "^9.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
