{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm db:generate && pnpm --filter @web3cash/worker build"
  },
  "deploy": {
    "startCommand": "pnpm db:migrate:deploy && pnpm --filter @web3cash/worker start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": null
  }
}
